{
  "name": "messhisab-server",
  "version": "1.0.0",
  "description": "Multi-tenant Mess and Room Expense Management SaaS Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/schema.prisma\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.28",
    "@prisma/client": "6.19.3",
    "better-auth": "^1.7.28",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
